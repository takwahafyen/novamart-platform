# ============================================
# NovaMart Platform — Environment Configuration
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority

# Security (Generate a 64+ char random hex string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed Frontend Origins (Comma-separated for multiple domains in production)
CLIENT_URL=http://localhost:3000,http://localhost:3001,https://novamart-store.vercel.app

# Optional Payment Gateway
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
