{
  "name": "novamart-platform",
  "version": "1.0.0",
  "description": "Full-Stack Enterprise Commerce Platform with Next.js, Express & MongoDB",
  "main": "backend/index.js",
  "type": "module",
  "scripts": {
    "backend": "nodemon backend/index.js",
    "frontend": "npm run dev --prefix frontend",
    "admin": "npm run dev --prefix admin-dash",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": ["ecommerce", "nextjs", "express", "mongodb", "docker", "ci-cd"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.7.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0",
    "vitest": "^1.6.0"
  }
}
